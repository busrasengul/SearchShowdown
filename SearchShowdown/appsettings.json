{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "Id": "85d76424-2168-4f56-ad2b-7680e1e4d207"
      },
      "Content": {
        "AllowEditInvariantFromNonDefault": true,
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        }
      },
      "Unattended": {
        "UpgradeUnattended": true
      },
      "Security": {
        "AllowConcurrentLogins": false
      }
    }
  },
  "AlgoliaSearchProvider": {
    "Client": {
      "AppId": "",
      "ApiKey": ""
    }
  },
  "AzureSearchProvider": {
    "Endpoint": "",
    "ApiKey": "",
    "IndexPrefix": "",
    "FuzzySearch": true
  }
}